{
  "game_title": "RBT Engine v2.0",
  "initial": { "scene": "village", "spawn": "default" },
  "input": {
    "actions": {
      "MoveLeft":  ["A", "LEFT"],
      "MoveRight": ["D", "RIGHT"],
      "MoveUp":    ["W", "UP"],
      "MoveDown":  ["S", "DOWN"],
      "Interact":  ["E", "RETURN"],
      "Jump":      ["SPACE"],
      "Confirm":   ["RETURN", "SPACE"],
      "Pause":     ["ESCAPE"]
    },
    "axes": {
      "Horizontal": ["MoveLeft", "MoveRight"],
      "Vertical":   ["MoveUp", "MoveDown"]
    }
  },
  "tilesets": {
    "overworld": {
      "tile_size": 32,
      "tiles": {
        "0":  { "texture": "grass.png" },
        "1":  { "texture": "tree.png", "solid": true },
        "2":  { "texture": "dirt.png" },
        "3":  { "texture": "water.png", "solid": true },
        "4":  { "texture": "bridge.png" },
        "5":  { "texture": "wall.png", "solid": true },
        "6":  { "texture": "roof.png", "solid": true },
        "7":  { "texture": "door.png", "trigger": "to_house1" },
        "8":  { "texture": "flower.png" },
        "9":  { "texture": "fence.png", "solid": true },
        "10": { "texture": "wood.png" },
        "11": { "texture": "inWall.png", "solid": true },
        "12": { "texture": "rug.png" },
        "13": { "texture": "sofa.png", "solid": true },
        "14": { "texture": "stage.png" },
        "15": { "texture": "entrance.png", "trigger": "exit" },
        "16": { "texture": "decor.png" },
        "17": { "texture": "mic.png", "trigger": "boss" },
        "18": { "texture": "door.png", "trigger": "to_house2" },
        "19": { "texture": "door.png", "trigger": "to_house3" }
      }
    }
  },
  "scenes": {
    "level1": {
      "view": "PlayView",
      "controller": "PlayController",
      "map": "level1.map",
      "tileset": "overworld",
      "spawns": { "default": [0, 0] },
      "player": {
        "behavior": "Player",
        "tag": "player",
        "texture": "redPlayer.png",
        "size": [50, 50],
        "params": {
          "frames": 6,
          "rows": 1,
          "speed": 300,
          "platformer": true,
          "gravity": 1800,
          "animations": {
            "idle": { "frames": [0], "fps": 1, "loop": true },
            "walk": { "frames": [0, 1, 2, 3, 4, 5], "fps": 10, "loop": true }
          }
        }
      }
    },
    "village": {
      "view": "VillageView",
      "controller": "VillageController",
      "map": "village.map",
      "tileset": "overworld",
      "spawns": {
        "default": [100, 100],
        "from_house1": [192, 230],
        "from_house2": [736, 262],
        "from_house3": [160, 656]
      },
      "player": {
        "behavior": "Player",
        "tag": "player",
        "texture": "rpgPlayer.png",
        "size": [50, 50],
        "params": {
          "frames": 4,
          "rows": 4,
          "speed": 240,
          "animations": {
            "idle_down":  { "frames": [0], "fps": 1, "loop": true },
            "idle_left":  { "frames": [4], "fps": 1, "loop": true },
            "idle_right": { "frames": [8], "fps": 1, "loop": true },
            "idle_up":    { "frames": [12], "fps": 1, "loop": true },
            "walk_down":  { "frames": [0, 1, 2, 3], "fps": 10, "loop": true },
            "walk_left":  { "frames": [4, 5, 6, 7], "fps": 10, "loop": true },
            "walk_right": { "frames": [8, 9, 10, 11], "fps": 10, "loop": true },
            "walk_up":    { "frames": [12, 13, 14, 15], "fps": 10, "loop": true }
          }
        }
      },
      "transitions": [
        { "trigger": "to_house1", "target": "house1", "spawn": "entrance", "transition": { "type": "page_curl", "duration": 0.9, "curlRadius": 0.14, "curvature": 0.8, "shadowStrength": 0.7, "highlightStrength": 0.35, "backsideDarken": 0.18 } },
        { "trigger": "to_house2", "target": "house2", "spawn": "entrance", "transition": { "type": "page_curl", "duration": 0.9 } },
        { "trigger": "to_house3", "target": "house3", "spawn": "entrance", "transition": { "type": "page_curl", "duration": 0.9 } }
      ]
    },
    "house1": {
      "view": "VillageView",
      "controller": "VillageController",
      "map": "house1.map",
      "tileset": "overworld",
      "spawns": { "default": [128, 186], "entrance": [128, 186] },
      "player": {
        "behavior": "Player",
        "tag": "player",
        "texture": "rpgPlayer.png",
        "size": [50, 50],
        "params": {
          "frames": 4,
          "rows": 4,
          "speed": 240,
          "animations": {
            "idle_down":  { "frames": [0], "fps": 1, "loop": true },
            "idle_left":  { "frames": [4], "fps": 1, "loop": true },
            "idle_right": { "frames": [8], "fps": 1, "loop": true },
            "idle_up":    { "frames": [12], "fps": 1, "loop": true },
            "walk_down":  { "frames": [0, 1, 2, 3], "fps": 10, "loop": true },
            "walk_left":  { "frames": [4, 5, 6, 7], "fps": 10, "loop": true },
            "walk_right": { "frames": [8, 9, 10, 11], "fps": 10, "loop": true },
            "walk_up":    { "frames": [12, 13, 14, 15], "fps": 10, "loop": true }
          }
        }
      },
      "transitions": [
        { "trigger": "exit", "target": "village", "spawn": "from_house1" },
        { "trigger": "boss", "target": "battle", "automatic": false }
      ]
    },
    "house2": {
      "view": "VillageView",
      "controller": "VillageController",
      "map": "house2.map",
      "tileset": "overworld",
      "spawns": { "default": [128, 186], "entrance": [128, 186] },
      "player": {
        "behavior": "Player",
        "tag": "player",
        "texture": "rpgPlayer.png",
        "size": [50, 50],
        "params": {
          "frames": 4,
          "rows": 4,
          "speed": 240,
          "animations": {
            "idle_down":  { "frames": [0], "fps": 1, "loop": true },
            "idle_left":  { "frames": [4], "fps": 1, "loop": true },
            "idle_right": { "frames": [8], "fps": 1, "loop": true },
            "idle_up":    { "frames": [12], "fps": 1, "loop": true },
            "walk_down":  { "frames": [0, 1, 2, 3], "fps": 10, "loop": true },
            "walk_left":  { "frames": [4, 5, 6, 7], "fps": 10, "loop": true },
            "walk_right": { "frames": [8, 9, 10, 11], "fps": 10, "loop": true },
            "walk_up":    { "frames": [12, 13, 14, 15], "fps": 10, "loop": true }
          }
        }
      },
      "transitions": [
        { "trigger": "exit", "target": "village", "spawn": "from_house2" },
        { "trigger": "boss", "target": "battle", "automatic": false }
      ]
    },
    "house3": {
      "view": "VillageView",
      "controller": "VillageController",
      "map": "house3.map",
      "tileset": "overworld",
      "spawns": { "default": [128, 186], "entrance": [128, 186] },
      "player": {
        "behavior": "Player",
        "tag": "player",
        "texture": "rpgPlayer.png",
        "size": [50, 50],
        "params": {
          "frames": 4,
          "rows": 4,
          "speed": 240,
          "animations": {
            "idle_down":  { "frames": [0], "fps": 1, "loop": true },
            "idle_left":  { "frames": [4], "fps": 1, "loop": true },
            "idle_right": { "frames": [8], "fps": 1, "loop": true },
            "idle_up":    { "frames": [12], "fps": 1, "loop": true },
            "walk_down":  { "frames": [0, 1, 2, 3], "fps": 10, "loop": true },
            "walk_left":  { "frames": [4, 5, 6, 7], "fps": 10, "loop": true },
            "walk_right": { "frames": [8, 9, 10, 11], "fps": 10, "loop": true },
            "walk_up":    { "frames": [12, 13, 14, 15], "fps": 10, "loop": true }
          }
        }
      },
      "transitions": [
        { "trigger": "exit", "target": "village", "spawn": "from_house3" },
        { "trigger": "boss", "target": "battle", "automatic": false }
      ]
    },
    "battle": {
      "view": "BattleView",
      "controller": "BattleController",
      "params": { "return_scene": "village" }
    }
  }
}
