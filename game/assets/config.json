{
  "game_title": "Memory Island",
  "initial": { "scene": "island", "spawn": "default" },
  "input": {
    "actions": {
      "MoveLeft":  ["A", "LEFT"],
      "MoveRight": ["D", "RIGHT"],
      "MoveUp":    ["W", "UP"],
      "MoveDown":  ["S", "DOWN"],
      "Interact":  ["E", "RETURN"],
      "Jump":      ["SPACE"],
      "Confirm":   ["RETURN", "SPACE"],
      "Pause":     ["ESCAPE"]
    },
    "axes": {
      "Horizontal": ["MoveLeft", "MoveRight"],
      "Vertical":   ["MoveUp", "MoveDown"]
    }
  },
  "tilesets": {
    "island": {
      "tile_size": 32,
      "tiles": {
        "0": { "texture": "grass.png" },
        "1": { "texture": "dirt.png" },
        "2": { "texture": "water.png", "solid": true },
        "3": { "texture": "tree.png", "solid": true, "overlay": true },
        "4": { "texture": "wall.png", "solid": true, "overlay": true },
        "5": { "texture": "roof.png", "solid": true, "overlay": true },
        "6": { "texture": "door.png", "overlay": true },
        "7": { "texture": "fence.png", "solid": true, "overlay": true },
        "8": { "texture": "flower.png" },
        "9": { "texture": "bridge.png" }
      }
    }
  },
  "scenes": {
    "island": {
      "view": "WorldView",
      "map": "island.map",
      "tileset": "island",
      "spawns": { "default": [240, 300] },
      "player": {
        "behavior": "Player",
        "tag": "player",
        "texture": "player_sheet.png",
        "size": [48, 48],
        "params": {
          "cols": 6,
          "rows": 5,
          "speed": 180,
          "animations": {
            "idle":       { "frames": [0], "fps": 1, "loop": true },
            "walk_down":  { "frames": [6, 7, 8, 9, 10, 11], "fps": 8.33, "loop": true },
            "walk_up":    { "frames": [12, 13, 14, 15, 16, 17], "fps": 8.33, "loop": true },
            "walk_left":  { "frames": [18, 19, 20, 21, 22, 23], "fps": 8.33, "loop": true },
            "walk_right": { "frames": [24, 25, 26, 27, 28, 29], "fps": 8.33, "loop": true }
          }
        }
      }
    }
  }
}
